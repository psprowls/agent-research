{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: File",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "stopOnEntry": false,
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "AWS_PROFILE": "pat-dev",
                "AWS_REGION": "us-west-2",
                "IS_LOCAL": "true"
            },
            "args": [
                "scan"
            ]
        },
        {
            "name": "gw guidance suggest",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "stopOnEntry": false,
            "program": "${workspaceFolder}/.venv/bin/gw",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "AWS_PROFILE": "pat-dev",
                "AWS_REGION": "us-east-1",
                "IS_LOCAL": "true"
            },
            "args": [
                "guidance",
                "suggest",
                "harden test isolation",
                "--path",
                "packages/claude-code-evals/src/claude_code_evals/isolation.py"
            ]
        },
    ]
}