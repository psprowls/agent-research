# Local GSD runtime state and execution logs
STATE.md
state-manifest.json
event-log.jsonl
notifications.jsonl
metrics.json

# SQLite WAL sidecars; commit gsd.db only after gsd_checkpoint_db
gsd.db-shm
gsd.db-wal

# Runtime directories generated by GSD sessions
activity/
audit/
exec/
journal/
runtime/
worktrees/

# Browser/tool artifacts are normally written outside .gsd; keep any nested copies out too
browser-state/
browser-baselines/
browser-artifacts/
