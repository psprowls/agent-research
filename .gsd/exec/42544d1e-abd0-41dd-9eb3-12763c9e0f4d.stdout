## packages/eval-harness/pyproject.toml
[project]
name = "eval-harness"
version = "0.1.0"
description = "Deterministic eval checks, pricing, and sweep runner for graph-wiki-agent"
requires-python = ">=3.11"
dependencies = [
    "deepeval>=4.0.0",
    "pytest-evals>=0.3.4",
    "python-frontmatter>=1.1.0",
    "aiobotocore>=2.13",
    "graph-wiki-agent",
    "subagent-runtime",
    "model-adapter",
    "graph-io",
    "workspace-io",
]

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.uv.sources]
graph-wiki-agent = { workspace = true }
subagent-runtime = { workspace = true }
model-adapter = { workspace = true }
graph-io = { workspace = true }
workspace-io = { workspace = true }

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["tests"]
addopts = "--import-mode=importlib"
asyncio_mode = "auto"
markers = [
    "integration: requires real Bedrock (skipped by default)",
    "eval: requires GRAPH_WIKI_RUN_EVAL=1 to run sweep evaluations",
]
## packages/graph-io/pyproject.toml
[project]
name = "graph-io"
version = "0.2.1"
description = "Code-graph core for the graph-wiki ecosystem — SQLite store, manifest scanning, queries, and the cg CLI."
authors = [
  { name = "Patrick Sprowls", email = "psprowls@gmail.com" },
]
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
  "source-parser",
  "workspace-io",
  "pyyaml>=6.0",
]

[project.scripts]
cg = "graph_io.cli.main:main"

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.uv.sources]
source-parser = { workspace = true }
workspace-io = { workspace = true }

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
  "integration: requires the agent-research workspace graph (skipped when unavailable)",
]
## packages/model-adapter/pyproject.toml
[project]
name = "model-adapter"
version = "0.1.0"
description = "AWS Bedrock model loader for graph-wiki-agent"
requires-python = ">=3.11"
dependencies = [
    "langchain-aws>=1.4.6",
    "boto3>=1.38",
]

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.uv.build.include]
include = ["src/model_adapter/models.toml"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--import-mode=importlib"
# Mirror the workspace-root convention (CLAUDE.md §8): this local config
# overrides the root when pytest's rootdir resolves to this package, so the
# async-mode setting must be repeated here for `async def test_*` collection.
asyncio_mode = "auto"
## packages/source-parser/pyproject.toml
[project]
name = "source-parser"
version = "0.1.0"
description = "Tree-sitter-backed Python package that turns source files into a span-bearing SourceTree, with a graph projection aligned to lattice-graph."
authors = [
  { name = "Patrick Sprowls", email = "psprowls@gmail.com" },
]
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
  "tree-sitter>=0.23.0",
  "tree-sitter-language-pack>=0.8.0,<=1.6.2",
]

[project.optional-dependencies]
test = ["pytest>=8.0"]

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.hatch.build.targets.wheel]
packages = ["src/source_parser"]

[tool.hatch.build.targets.sdist]
include = ["src", "tests", "fixtures", "README.md", "CLAUDE.md"]

[tool.pytest.ini_options]
testpaths = ["tests"]
## packages/subagent-runtime/pyproject.toml
[project]
name = "subagent-runtime"
version = "0.1.0"
description = "Async fan-out primitive for graph-wiki-agent subagent dispatch"
requires-python = ">=3.11"
dependencies = [
    "langchain-aws>=1.4.6",
    "langchain-core>=1.4.0",
    "model-adapter",
]

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.uv.sources]
model-adapter = { workspace = true }

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--import-mode=importlib"
asyncio_mode = "auto"
markers = ["integration: requires real Bedrock (skipped by default)"]
## packages/wiki-io/pyproject.toml
[project]
name = "wiki-io"
version = "0.1.0"
description = "Vault IO for graph-wiki-agent"
requires-python = ">=3.11"
dependencies = [
    "python-frontmatter>=1.1",
    "boto3>=1.38",
    "workspace-io",
]

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.uv.sources]
workspace-io = { workspace = true }

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--import-mode=importlib"
markers = ["integration: requires real Bedrock or subprocess (skipped in CI by default)"]
## packages/workspace-io/pyproject.toml
[project]
name = "workspace-io"
version = "0.1.0"
description = "Workspace bootstrap, manifest IO, and config resolution for the graph-wiki ecosystem."
requires-python = ">=3.11"
dependencies = ["pyyaml>=6.0"]

[build-system]
requires = ["uv_build>=0.11.14,<0.12"]
build-backend = "uv_build"

[tool.uv.build.include]
include = ["src/workspace_io/assets/CLAUDE.md.template"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--import-mode=importlib"

