369: export function openDatabaseByWorkspace(workspace) {
370:     const key = workspace.identityKey;
371:     const dbPath = workspace.contract.projectDb;
372:     const cached = _dbCache.get(key);
373:     if (cached) {
374:         // Reactivate the cached connection as the current singleton.
375:         currentDb = cached.db;
376:         currentPath = cached.dbPath;
377:         currentPid = process.pid;
378:         _dbOpenState.markAttempted();
379:         _currentIdentityKey = key;
380:         return true;
381:     }
382:     // Cache miss — need to open a new connection.
383:     //
384:     // If there is a currently active workspace connection, stash it in the
385:     // cache under its identity key before calling openDatabase(), because
386:     // openDatabase() will call closeDatabase() when the path changes (which
387:     // would destroy the existing adapter). By nulling out currentDb first,
388:     // we prevent openDatabase() from closing the live adapter.
389:     let oldDb = null;
390:     let oldPath = null;
391:     let oldPid = 0;
392:     let oldKey = null;
393:     if (currentDb !== null && _currentIdentityKey !== null) {
394:         // Snapshot the old globals so we can restore them on failure.
395:         oldDb = currentDb;
396:         oldPath = currentPath;
397:         oldPid = currentPid;
398:         oldKey = _currentIdentityKey;
399:         // Save the current connection so it stays alive in the cache.
400:         _dbCache.set(_currentIdentityKey, {
401:             dbPath: currentPath,
402:             db: currentDb,
403:         });
404:         // Detach from globals so openDatabase() opens fresh without closing it.
405:         currentDb = null;
406:         currentPath = null;
407:         currentPid = 0;
408:         _currentIdentityKey = null;
409:     }
410:     // Run the full open/schema/migration flow for the new workspace.
411:     // openDatabase() can throw on corrupt DB or permission error — catch so we
412:     // can restore the previous connection rather than leaving globals null.
413:     let opened;
414:     try {
415:         opened = openDatabase(dbPath);
