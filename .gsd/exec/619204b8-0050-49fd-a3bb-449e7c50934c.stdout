---
446: export function openDatabaseByScope(scope) {
447:     return openDatabaseByWorkspace(scope.workspace);
448: }
449: /**
450:  * Close the database connection for the given workspace and remove it from
451:  * the cache. If the workspace's connection is currently active (currentDb),
452:  * performs a full closeDatabase() including WAL checkpoint. Otherwise only
453:  * removes the cache entry (the adapter was already replaced by a later open).
454:  */
455: export function closeDatabaseByWorkspace(workspace) {
456:     const key = workspace.identityKey;
457:     const cached = _dbCache.get(key);
458:     if (!cached)
459:         return;
460:     _dbCache.delete(key);
461:     if (currentDb === cached.db) {
462:         // This workspace's connection is the active one — full close.
463:         closeDatabase();
464:     }
465:     else {
466:         // Connection was displaced by a later open; close the adapter directly.
467:         closeCachedConnection(cached, "workspace");
468:     }
469: }
470: export function getDbProvider() {
471:     providerLoader.load();
472:     return providerLoader.getProviderName();
473: }
474: export function isDbAvailable() {
475:     return currentDb !== null;
476: }
477: /**
478:  * Returns true if openDatabase() has been called at least once this session.
479:  * Used to distinguish "DB not yet initialized" from "DB genuinely unavailable"
480:  * so that early callers (e.g. before_agent_start context injection) don't
481:  * trigger a false degraded-mode warning.
482:  */
483: export function wasDbOpenAttempted() {
484:     return _dbOpenState.snapshot().attempted;
485: }
486: export function getDbStatus() {
487:     providerLoader.load();
488:     const openState = _dbOpenState.snapshot();
489:     return {
490:         available: currentDb !== null,
491:         provider: providerLoader.getProviderName(),
492:         attempted: openState.attempted,
493:         lastError: openState.lastError,
494:         lastPhase: openState.lastPhase,
495:     };
---
497: export function openDatabase(path) {
498:     _dbOpenState.markAttempted();
499:     if (currentDb && currentPath !== path)
500:         closeDatabase();
501:     if (currentDb && currentPath === path)
502:         return true;
503:     // Reset error state only when a new open attempt is actually going to run.
504:     _dbOpenState.clearError();
505:     let rawDb;
506:     let fallbackOpen = null;
507:     try {
508:         rawDb = providerLoader.openRaw(path);
509:     }
510:     catch (primaryErr) {
511:         _dbOpenState.recordError("open", primaryErr);
512:         // node:sqlite loaded but failed to open this file — try better-sqlite3 as fallback.
513:         fallbackOpen = providerLoader.tryOpenBetterSqliteFallback(path);
514:         if (fallbackOpen) {
515:             rawDb = fallbackOpen.rawDb;
516:             _dbOpenState.clearError();
517:         }
518:         if (!rawDb)
519:             throw primaryErr;
520:     }
521:     if (!rawDb)
522:         return false;
523:     const adapter = createDbAdapter(rawDb);
524:     const fileBacked = path !== ":memory:";
525:     try {
526:         initSchema(adapter, fileBacked, path);
527:     }
528:     catch (err) {
529:         // Corrupt freelist: DDL fails with "malformed" but VACUUM can rebuild.
530:         // Attempt VACUUM recovery before giving up (see #2519).
531:         if (fileBacked && err instanceof Error && err.message?.includes("malformed")) {
532:             try {
533:                 adapter.exec("VACUUM");
534:                 initSchema(adapter, fileBacked, path);
535:                 process.stderr.write("gsd-db: recovered corrupt database via VACUUM\n");
536:             }
537:             catch (retryErr) {
538:                 _dbOpenState.recordError("vacuum-recovery", retryErr);
539:                 try {
540:                     adapter.close();
541:                 }
542:                 catch (e) {
543:                     logWarning("db", `close after VACUUM failed: ${e.message}`);
544:                 }
545:                 throw retryErr;
546:             }
