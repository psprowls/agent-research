{"id":"R007","class":"admin/support","status":"deferred","description":"A broader structured index of legacy `.planning` artifacts may be created later if archive archaeology becomes frequent.","source":"user","primary_owner":"none","validation":"unmapped","notes":"Deferred because the user has backed up `.planning` and asked only for high notes now."}
{"id":"R008","class":"anti-feature","status":"out-of-scope","description":"Do not wholesale-convert every `.planning` artifact into `.gsd`.","source":"user","primary_owner":"none","validation":"n/a","notes":"The legacy archive includes many phase contexts, summaries, quick tasks, sketches, and spikes; only high notes should be curated."}
